---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';

const notes = (
  await getCollection('lab-notes', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="Lab Notes"
  description="Lab notes from Derek Wei's homelab and hands-on security practice — shorter, rougher working notes on setups, experiments, and what broke along the way."
>
  <PageHeader
    kicker="~/lab-notes"
    title="Lab Notes"
    lede="Shorter, rougher notes from the homelab and hands-on practice — what I set up, what broke, and what I learned fixing it."
  />

  <section class="py-10">
    {
      notes.length > 0 ? (
        <ul class="grid gap-4 sm:grid-cols-2" role="list">
          {notes.map((entry) => (
            <Card
              href={`/lab-notes/${entry.id}/`}
              title={entry.data.title}
              description={entry.data.description}
              meta={fmt(entry.data.date)}
              tags={[...entry.data.tags]}
            />
          ))}
        </ul>
      ) : (
        <div class="panel p-6">
          <h2 class="font-mono text-sm uppercase tracking-[0.15em] text-faint">
            <span class="text-accent" aria-hidden="true">
              //
            </span>{' '}
            lab notes incoming
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
            Notes from the{' '}
            <a href="/projects/home-security-lab/" class="link">
              home security lab
            </a>{' '}
            build will land here first — setup logs, configuration notes, and the inevitable
            breakage along the way.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
