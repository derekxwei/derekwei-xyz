---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Badge from '../../components/Badge.astro';
import Prose from '../../components/Prose.astro';

export async function getStaticPaths() {
  const entries = await getCollection('lab-notes', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'lab-notes'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={entry.data.title} description={entry.data.description} ogType="article">
  <nav class="pt-8" aria-label="Breadcrumb">
    <a href="/lab-notes/" class="link font-mono text-sm">← All lab notes</a>
  </nav>

  <PageHeader
    kicker={`~/lab-notes/${entry.id}`}
    title={entry.data.title}
    lede={entry.data.description}
  >
    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
      <time
        datetime={entry.data.date.toISOString().slice(0, 10)}
        class="font-mono text-xs text-faint"
      >
        {fmt(entry.data.date)}
      </time>
      {
        entry.data.updated && (
          <time
            datetime={entry.data.updated.toISOString().slice(0, 10)}
            class="font-mono text-xs text-faint"
          >
            updated {fmt(entry.data.updated)}
          </time>
        )
      }
      {entry.data.tags.map((tag) => <Badge label={tag} />)}
    </div>
  </PageHeader>

  <section class="py-10">
    <Prose><Content /></Prose>
  </section>
</BaseLayout>
