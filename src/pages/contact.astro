---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE, CONTACT } from '../consts';

const mailtoHref = `mailto:${CONTACT.email}?subject=Professional%20Inquiry%20for%20Derek%20Wei`;
---

<BaseLayout
  title="Contact"
  description="Contact Derek Wei about cybersecurity internship opportunities, CTF collaboration, or security projects. Based in San Antonio, Texas."
>
  <PageHeader
    kicker="~/contact"
    title="Contact"
    lede="Email is the fastest way to reach me. Calls, texts, and LinkedIn work too."
  />

  <section class="mt-12 sm:mt-14">
    <h2 class="sr-only">How to reach me</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="panel p-6">
        <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-accent">Direct contact</h3>
        <dl class="mt-4 grid gap-3">
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-faint">Email Derek</dt>
            <dd class="mt-1">
              <a
                href={mailtoHref}
                class="link font-mono text-base sm:text-lg"
                aria-label={`Email Derek Wei at ${CONTACT.email}`}
                >{CONTACT.email}</a
              >
            </dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-faint">
              Call or text Derek
            </dt>
            <dd class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1">
              <a
                href={`tel:${CONTACT.phoneE164}`}
                class="link font-mono text-base sm:text-lg"
                aria-label={`Call Derek Wei at ${CONTACT.phoneDisplay}, his professional Google Voice number`}
                >{CONTACT.phoneDisplay}</a
              >
              <a
                href={`sms:${CONTACT.phoneE164}`}
                class="link font-mono text-sm"
                aria-label="Text Derek Wei at his professional Google Voice number"
                >Text Derek</a
              >
            </dd>
          </div>
        </dl>
        <p class="mt-4 text-sm leading-relaxed text-muted">Worth writing about:</p>
        <ul class="mt-2 grid gap-1.5 text-sm text-muted" role="list">
          <li class="flex gap-2">
            <span class="text-accent" aria-hidden="true">-</span>
            internship opportunities
          </li>
          <li class="flex gap-2">
            <span class="text-accent" aria-hidden="true">-</span>
            CTF teams and collaboration
          </li>
          <li class="flex gap-2">
            <span class="text-accent" aria-hidden="true">-</span>
            security projects and tooling
          </li>
          <li class="flex gap-2">
            <span class="text-accent" aria-hidden="true">-</span>
            questions about anything on this site
          </li>
        </ul>
        <ul class="mt-5 grid gap-1.5 border-t border-line pt-4 font-mono text-sm" role="list">
          <li>
            <a
              class="link"
              href={SITE.linkedin}
              rel="noopener noreferrer"
              aria-label="Connect on LinkedIn with Derek Wei">Connect on LinkedIn</a
            >
            <span class="text-faint"> /in/derekxwei</span>
          </li>
        </ul>
      </div>

      <div class="panel p-6">
        <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-accent">Details</h3>
        <dl class="mt-4 grid gap-4 text-sm">
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-faint">Location</dt>
            <dd class="mt-1 text-muted">{SITE.location}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-faint">Clearance</dt>
            <dd class="mt-1 text-muted">{SITE.clearance}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-faint">Status</dt>
            <dd class="mt-1 text-muted">
              Incoming UTSA B.S. Cybersecurity (Honors College) student, seeking cybersecurity
              internships.
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <p class="mt-8 text-sm leading-relaxed text-muted">
      There is no contact form here on purpose: this site is fully static, with no backend to
      receive one. That is a deliberate part of its
      <a href="/architecture/" class="link">security architecture</a>. Email works better anyway.
    </p>
  </section>
</BaseLayout>
