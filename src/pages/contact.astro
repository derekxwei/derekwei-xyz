---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import { SITE, CONTACT, CREDLY_PROFILE } from '../consts';

const mailtoHref = `mailto:${CONTACT.email}?subject=Professional%20Inquiry%20for%20Derek%20Wei`;

// Three tiers, so the page answers "what do I do now" before "what else is
// there". Email is the one primary action; call, text and LinkedIn are the
// alternatives; the rest are places to read more.
const alternatives = [
  {
    label: 'Call',
    value: CONTACT.phoneDisplay,
    href: `tel:${CONTACT.phoneE164}`,
    aria: `Call Derek Wei at ${CONTACT.phoneDisplay}, his professional Google Voice number`,
  },
  {
    label: 'Text',
    value: CONTACT.phoneDisplay,
    href: `sms:${CONTACT.phoneE164}`,
    aria: 'Text Derek Wei at his professional Google Voice number',
  },
  {
    label: 'LinkedIn',
    value: '/in/derekxwei',
    href: SITE.linkedin,
    aria: 'Connect on LinkedIn with Derek Wei',
    external: true,
  },
];

const supporting = [
  { label: 'Resume', value: 'One page, ATS readable', href: CONTACT.resumePdf },
  { label: 'Projects', value: 'Selected technical work', href: '/projects/' },
  {
    label: 'Credly',
    value: 'Verify every credential',
    href: CREDLY_PROFILE,
    external: true,
  },
];

const topics = [
  'internship opportunities',
  'CTF teams and collaboration',
  'security projects and tooling',
  'questions about anything on this site',
];
---

<BaseLayout
  title="Contact"
  description="Contact Derek Wei about cybersecurity internship opportunities, CTF collaboration, or security projects. Based in San Antonio, Texas."
>
  <header class="max-w-mid pt-10 sm:pt-14">
    <p class="kicker">~/contact</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">Contact</h1>
    <p class="mt-4 text-lg leading-relaxed text-prose-body">
      Email is the fastest way to reach me. Calls, texts, and LinkedIn work too.
    </p>
  </header>

  <!-- Primary action. One thing, stated once, at the largest size on the page. -->
  <section class="mt-10 max-w-mid border-t border-line pt-8" aria-labelledby="email-heading">
    <h2 id="email-heading" class="eyebrow">Preferred contact</h2>
    <p class="mt-3">
      <a
        href={mailtoHref}
        class="link font-mono text-2xl tracking-tight sm:text-3xl"
        aria-label={`Email Derek Wei at ${CONTACT.email}`}>{CONTACT.email}</a
      >
    </p>
    <p class="mt-4">
      <a href={mailtoHref} class="btn btn-primary">Email Derek</a>
    </p>
    <p class="mt-6 text-sm leading-relaxed text-muted">Worth writing about:</p>
    <ul class="mt-2 grid gap-1.5 text-sm text-muted" role="list">
      {
        topics.map((t) => (
          <li class="flex gap-2">
            <span class="text-accent" aria-hidden="true">
              -
            </span>
            {t}
          </li>
        ))
      }
    </ul>
  </section>

  <SectionHead width="mid" eyebrow="Alternatives" title="Other ways to reach me" id="other">
    <ul role="list" class="ledger mt-6 max-w-mid">
      {
        alternatives.map((a) => (
          <li class="lrow py-3 sm:grid-cols-[8rem_minmax(0,1fr)]">
            <p class="eyebrow sm:pt-1">{a.label}</p>
            <p class="font-mono text-base">
              <a
                class="link"
                href={a.href}
                aria-label={a.aria}
                rel={a.external ? 'noopener noreferrer' : undefined}
              >
                {a.value}
              </a>
            </p>
          </li>
        ))
      }
    </ul>
  </SectionHead>

  <SectionHead width="mid" eyebrow="Elsewhere" title="Before you write" id="elsewhere">
    <ul role="list" class="ledger mt-6 max-w-mid">
      {
        supporting.map((s) => (
          <li class="lrow py-3 sm:grid-cols-[8rem_minmax(0,1fr)]">
            <p class="eyebrow sm:pt-1">{s.label}</p>
            <p class="text-sm">
              <a
                class="link"
                href={s.href}
                rel={s.external ? 'noopener noreferrer' : undefined}
              >
                {s.value}
              </a>
            </p>
          </li>
        ))
      }
    </ul>
  </SectionHead>

  <SectionHead width="mid" eyebrow="Details" title="Availability" id="details">
    <dl class="ledger mt-6 max-w-mid">
      <div class="lrow py-3 sm:grid-cols-[8rem_minmax(0,1fr)]">
        <dt class="eyebrow sm:pt-1">Location</dt>
        <dd class="text-sm text-muted">{SITE.location}</dd>
      </div>
      <div class="lrow py-3 sm:grid-cols-[8rem_minmax(0,1fr)]">
        <dt class="eyebrow sm:pt-1">Clearance</dt>
        <dd class="text-sm text-muted">{SITE.clearance}</dd>
      </div>
      <div class="lrow py-3 sm:grid-cols-[8rem_minmax(0,1fr)]">
        <dt class="eyebrow sm:pt-1">Status</dt>
        <dd class="text-sm text-muted">
          Incoming UTSA B.S. Cybersecurity (Honors College) student, seeking
          cybersecurity internships.
        </dd>
      </div>
    </dl>
    <p class="mt-8 text-sm leading-relaxed text-muted">
      There is no contact form here on purpose: this site is fully static, with
      no backend to receive one. That is a deliberate part of its
      <a href="/architecture/" class="link">security architecture</a>. Email
      works better anyway.
    </p>
  </SectionHead>
</BaseLayout>
