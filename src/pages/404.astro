---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout
  title="Page not found"
  description="Error 404: the requested page does not exist on derekwei.xyz."
  noindex={true}
>
  <section class="py-16 sm:py-24">
    <p class="kicker">Error</p>
    <h1
      class="mt-3 font-mono text-6xl font-semibold tracking-tight sm:text-7xl"
    >
      404
    </h1>
    <p class="mt-4 leading-relaxed text-muted">
      Nothing lives at this path. It may have moved, or the URL has a typo.
    </p>

    <div class="panel mt-8 max-w-2xl">
      <pre
        class="overflow-x-auto p-5 font-mono text-sm leading-relaxed"><code><span class="text-faint" aria-hidden="true">$ </span>curl {SITE.url}/...
<span class="text-danger">curl: (22) The requested URL returned error: 404</span></code></pre>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Back home</a>
      <a href="/projects/" class="btn btn-ghost">Projects</a>
      <a href="/tools/" class="btn btn-ghost">Tools</a>
    </div>
  </section>
</BaseLayout>
