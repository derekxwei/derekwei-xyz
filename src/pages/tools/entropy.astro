---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<BaseLayout
  title="Password Entropy Estimator"
  description="Estimate password strength from character-set size and length, with a rough offline-crack time. Runs entirely in your browser — nothing is transmitted or stored."
>
  <PageHeader
    kicker="~/tools/entropy"
    title="Password entropy estimator"
    lede="Estimate a password's strength from its character set and length. Everything runs locally — the password is never sent or stored."
  />

  <section class="py-10">
    <div class="grid gap-4">
      <div>
        <label for="pw-input" class="label">Password</label>
        <div class="flex gap-2">
          <input
            id="pw-input"
            type="password"
            class="input font-mono"
            placeholder="Type a password to evaluate&hellip;"
            spellcheck="false"
            autocomplete="off"
            autocapitalize="off"
          />
          <button id="pw-toggle" type="button" class="btn btn-ghost shrink-0" aria-pressed="false">
            Show
          </button>
        </div>
      </div>
    </div>

    <div aria-live="polite">
      <div id="pw-results" class="mt-8" hidden>
        <div class="panel p-5">
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-mono text-xs uppercase tracking-wider text-faint">Strength</span>
            <span id="pw-rating" class="font-mono text-sm"></span>
          </div>
          <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-panel-2" role="presentation">
            <div id="pw-meter" class="h-full w-0 rounded-full transition-all"></div>
          </div>
          <dl class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4">
            <div>
              <dt class="font-mono text-xs uppercase tracking-wider text-faint">Entropy</dt>
              <dd id="pw-bits" class="mt-1 font-mono text-lg text-ink"></dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-wider text-faint">Length</dt>
              <dd id="pw-len" class="mt-1 font-mono text-lg text-ink"></dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-wider text-faint">Charset</dt>
              <dd id="pw-pool" class="mt-1 font-mono text-lg text-ink"></dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-wider text-faint">Crack time</dt>
              <dd id="pw-crack" class="mt-1 font-mono text-sm text-ink"></dd>
            </div>
          </dl>
          <p id="pw-charsets" class="mt-4 font-mono text-xs text-faint"></p>
        </div>
      </div>
    </div>

    <div class="mt-8 max-w-2xl space-y-3 text-sm leading-relaxed text-muted">
      <p>
        Entropy is estimated as <code class="font-mono text-xs text-ink">length × log2(pool size)</code>,
        where pool size is the number of distinct character classes used. The crack-time figure assumes
        <strong class="text-ink">10<sup>10</sup> guesses per second</strong> against a fast offline attack
        on a well-chosen hash, and shows the <em>average</em> (half the keyspace).
      </p>
      <p>
        This is a first-order model. It does <strong class="text-ink">not</strong> catch dictionary words,
        keyboard walks, l33t substitutions, or reuse — a tool like zxcvbn does that far better. A long,
        random, unique passphrase from a password manager beats anything you can type from memory.
      </p>
    </div>

    <p class="mt-10">
      <a href="/tools/" class="link font-mono text-sm">&larr; ~/tools</a>
    </p>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('pw-input') as HTMLInputElement | null;
  const toggle = document.getElementById('pw-toggle') as HTMLButtonElement | null;
  const results = document.getElementById('pw-results');
  const rating = document.getElementById('pw-rating');
  const meter = document.getElementById('pw-meter');
  const bitsEl = document.getElementById('pw-bits');
  const lenEl = document.getElementById('pw-len');
  const poolEl = document.getElementById('pw-pool');
  const crackEl = document.getElementById('pw-crack');
  const charsetsEl = document.getElementById('pw-charsets');

  const GUESSES_PER_SEC = 1e10;

  interface Band {
    label: string;
    color: string;
    text: string;
    width: string;
  }

  function band(bits: number): Band {
    if (bits < 28) return { label: 'very weak', color: 'bg-danger', text: 'text-danger', width: 'w-[15%]' };
    if (bits < 40) return { label: 'weak', color: 'bg-danger', text: 'text-danger', width: 'w-[35%]' };
    if (bits < 60) return { label: 'reasonable', color: 'bg-warn', text: 'text-warn', width: 'w-3/5' };
    if (bits < 80) return { label: 'strong', color: 'bg-accent', text: 'text-accent', width: 'w-4/5' };
    return { label: 'very strong', color: 'bg-accent', text: 'text-accent', width: 'w-full' };
  }

  function poolSize(pw: string): { size: number; classes: string[] } {
    const classes: string[] = [];
    let size = 0;
    if (/[a-z]/.test(pw)) { size += 26; classes.push('lower'); }
    if (/[A-Z]/.test(pw)) { size += 26; classes.push('upper'); }
    if (/[0-9]/.test(pw)) { size += 10; classes.push('digits'); }
    if (/[^A-Za-z0-9]/.test(pw)) { size += 33; classes.push('symbols'); }
    return { size, classes };
  }

  function humanTime(seconds: number): string {
    if (!isFinite(seconds)) return 'effectively forever';
    if (seconds < 1) return 'under a second';
    const units: [string, number][] = [
      ['year', 31557600],
      ['day', 86400],
      ['hour', 3600],
      ['minute', 60],
      ['second', 1],
    ];
    for (const [name, secs] of units) {
      if (seconds >= secs) {
        const n = seconds / secs;
        if (name === 'year' && n >= 1e6) {
          const exp = Math.floor(Math.log10(n));
          return `~10^${String(exp)} years`;
        }
        const rounded = n >= 10 ? Math.round(n) : Math.round(n * 10) / 10;
        return `~${String(rounded)} ${name}${rounded === 1 ? '' : 's'}`;
      }
    }
    return 'under a second';
  }

  function evaluate(): void {
    if (!input || !results) return;
    const pw = input.value;
    if (pw.length === 0) {
      results.hidden = true;
      return;
    }

    const { size, classes } = poolSize(pw);
    const bits = size > 0 ? pw.length * Math.log2(size) : 0;
    const b = band(bits);

    // average guesses = half the keyspace = 2^(bits-1)
    const seconds = Math.pow(2, bits - 1) / GUESSES_PER_SEC;

    if (rating) {
      rating.textContent = b.label;
      rating.className = `font-mono text-sm ${b.text}`;
    }
    if (meter) meter.className = `h-full rounded-full transition-all ${b.color} ${b.width}`;
    if (bitsEl) bitsEl.textContent = `${bits.toFixed(1)} bits`;
    if (lenEl) lenEl.textContent = String(pw.length);
    if (poolEl) poolEl.textContent = String(size);
    if (crackEl) crackEl.textContent = humanTime(seconds);
    if (charsetsEl) {
      charsetsEl.textContent = classes.length > 0 ? `character classes: ${classes.join(', ')}` : '';
    }
    results.hidden = false;
  }

  input?.addEventListener('input', evaluate);

  toggle?.addEventListener('click', () => {
    if (!input) return;
    const show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    toggle.textContent = show ? 'Hide' : 'Show';
    toggle.setAttribute('aria-pressed', String(show));
    input.focus();
  });
</script>
