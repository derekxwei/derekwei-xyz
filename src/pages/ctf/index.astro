---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import { COMPETITIONS } from '../../consts';

const allWriteups = await getCollection('writeups', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);

// One-line team result shown per event, keyed by the `event` frontmatter value.
const eventResults: Record<string, string> = {
  'RowdyHacks XII': 'Team Difference — 1st of 62 teams, full clear (all 27 challenges).',
  'BroncoCTF 2026': 'Team idktheflag — 8th of 753 teams.',
};

// A stable anchor per event so the competitions list can deep-link a group.
const eventAnchor = (event: string) =>
  event
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

// Group writeups by event. Within a group, lead with the highest point value
// (RowdyHacks scored by points), then by most recent. Groups themselves are
// ordered by their most recent writeup, so the latest event leads the page.
const groups = [...new Set(allWriteups.map((w) => w.data.event))]
  .map((event) => {
    const entries = allWriteups
      .filter((w) => w.data.event === event)
      .sort(
        (a, b) =>
          (b.data.points ?? 0) - (a.data.points ?? 0) ||
          b.data.date.valueOf() - a.data.date.valueOf()
      );
    const latest = Math.max(...entries.map((e) => e.data.date.valueOf()));
    return { event, entries, latest, result: eventResults[event] };
  })
  .sort((a, b) => b.latest - a.latest);

const totalWriteups = allWriteups.length;

const categories = [
  { name: 'Web', note: 'web application exploitation' },
  { name: 'Cryptography', note: 'ciphers, hashing, and key mistakes' },
  { name: 'Forensics', note: 'disk, memory, and traffic analysis' },
  { name: 'Reverse engineering', note: 'reading and understanding binaries' },
  { name: 'Binary exploitation (pwn)', note: 'memory-corruption and control-flow bugs' },
  { name: 'OSINT', note: 'open source intelligence gathering' },
  { name: 'Miscellaneous', note: 'scripting, recon, and everything else' },
];

const structure = [
  'Challenge, event, category, and difficulty',
  'Goal and initial observations',
  'Enumeration and recon',
  'Failed attempts (the useful part)',
  'Breakthrough and solution summary',
  'Defensive takeaway',
  'Tools used and lessons learned',
];
---

<BaseLayout
  title="CTF Writeups"
  description="Capture the Flag writeups by Derek Wei: offensive-security methodology from RowdyHacks XII (1st place), National Cyber League, BYU CTF, and other authorized competitions."
>
  <header class="max-w-mid pt-10 sm:pt-14">
    <p class="kicker">~/ctf</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">CTF writeups</h1>
    <p class="mt-4 text-lg leading-relaxed text-prose-body">
      Offensive-security methodology from Capture the Flag competitions,
      written to learn in public: reasoning and approach over flag spoilers.
    </p>
    <p class="mt-4 font-mono text-sm text-muted">
      Most recent result:{' '}
      <span class="text-accent">RowdyHacks XII — 1st of 62 teams, full clear</span>{' '}
      (all 27 challenges), Team Difference.
    </p>
    <p class="mt-2 font-mono text-xs text-faint">
      A team win first and foremost — within it, Derek contributed 3,575 of the
      team's 5,825 points as top scorer.
    </p>
  </header>

  <SectionHead width="mid" eyebrow="Background" title="What is a CTF?" id="about-ctf" tight>
    <div class="mt-4 space-y-3 leading-relaxed text-muted">
      <p>
        A Capture the Flag (CTF) is a legal, sanctioned competition where players solve
        security challenges to recover hidden tokens called flags. Everything runs against
        infrastructure the organizers set up for exactly that purpose, so it is a safe way
        to practice offensive techniques without touching real systems.
      </p>
      <p>
        These writeups follow a red-team learning approach: enumerate, form a hypothesis,
        test it, and document what worked and what did not. They describe only authorized
        practice. There are no live flags, no unauthorized targets, and no guidance for
        acting against systems you do not own or have explicit permission to test. Where an
        offensive finding has a clear defensive lesson, the writeup calls it out.
      </p>
    </div>
  </SectionHead>

  <SectionHead
    width="evidence"
    eyebrow="Publications"
    title="Published writeups"
    id="published"
  >
    {
      totalWriteups > 0 ? (
        /* A publication index grouped by event: each event states its team
           result, then lists its writeups (highest point value first). */
        <div class="mt-6 space-y-14">
          {groups.map((group) => (
            <section id={eventAnchor(group.event)} aria-label={group.event} class="scroll-mt-24">
              <div class="border-l-2 border-accent/60 pl-4">
                <h3 class="text-2xl font-semibold tracking-tight">{group.event}</h3>
                {group.result && (
                  <p class="mt-1 font-mono text-sm text-accent">{group.result}</p>
                )}
                <p class="mt-1 font-mono text-xs text-faint">
                  {group.entries.length} writeup{group.entries.length === 1 ? '' : 's'}
                </p>
              </div>
              <ol role="list" class="ledger mt-5 max-w-evidence">
                {group.entries.map((entry) => (
                  <li class="lrow py-7 sm:grid-cols-[minmax(0,1fr)_11rem]">
                    <div>
                      <p class="eyebrow">
                        {entry.data.category}
                        {entry.data.points != null && ` · ${entry.data.points} pts`}
                        {entry.data.difficulty && ` · ${entry.data.difficulty}`}
                      </p>
                      <h4 class="mt-1.5 text-xl font-semibold tracking-tight">
                        <a class="link no-underline hover:underline" href={`/ctf/${entry.id}/`}>
                          {entry.data.title}
                        </a>
                      </h4>
                      <p class="mt-2 leading-relaxed text-prose-body">{entry.data.description}</p>
                      <p class="lmeta mt-2">{entry.data.tags.slice(0, 4).join(' / ')}</p>
                      <p class="mt-4">
                        <a class="btn btn-ghost" href={`/ctf/${entry.id}/`}>
                          Read the writeup
                        </a>
                      </p>
                    </div>
                    <p class="lnum sm:pt-1 sm:text-right">
                      {entry.data.date.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        timeZone: 'UTC',
                      })}
                    </p>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      ) : (
        <div class="panel mt-5 p-6">
          <p class="text-sm leading-relaxed text-muted">
            Writeups are being prepared and sanitized before publishing. The goal is to
            document methodology and reasoning, dead ends included, not just flags. They will
            appear here as they are finished.
          </p>
          <p
            id="competed-events"
            class="mt-6 font-mono text-xs uppercase tracking-wider text-faint"
          >
            Events I have competed in
          </p>
          <ul
            role="list"
            aria-labelledby="competed-events"
            class="mt-2 grid gap-1.5 sm:grid-cols-2"
          >
            {COMPETITIONS.map((c) => (
              <li class="font-mono text-sm text-muted">
                <span class="text-accent" aria-hidden="true">
                  -
                </span>{' '}
                {c.name} <span class="text-faint"> ({c.kind})</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </SectionHead>

  <SectionHead width="mid" eyebrow="Scope" title="Categories" id="categories">
    <dl class="ledger mt-6 max-w-mid">
      {
        categories.map((cat) => (
          <div class="lrow py-2.5 sm:grid-cols-[14rem_minmax(0,1fr)]">
            <dt class="font-mono text-sm text-accent sm:pt-0.5">{cat.name}</dt>
            <dd class="text-sm leading-relaxed text-muted">{cat.note}</dd>
          </div>
        ))
      }
    </dl>
  </SectionHead>

  <SectionHead
    width="mid"
    eyebrow="Method"
    title="How I structure a writeup"
    id="how-i-write"
    note="Each writeup follows the same outline so the reasoning stays easy to follow."
  >
    <!-- Numbered here because the outline really is a sequence. -->
    <ol class="ledger mt-6 max-w-mid" role="list">
      {
        structure.map((step, i) => (
          <li class="lrow py-2.5 sm:grid-cols-[3rem_minmax(0,1fr)]">
            <span class="lnum text-accent sm:pt-0.5">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-sm leading-relaxed text-muted">{step}</span>
          </li>
        ))
      }
    </ol>
  </SectionHead>
</BaseLayout>
