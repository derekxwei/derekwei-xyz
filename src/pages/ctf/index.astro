---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import { COMPETITIONS } from '../../consts';

const writeups = (
  await getCollection('writeups', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [
  { name: 'Web', note: 'web application exploitation' },
  { name: 'Cryptography', note: 'ciphers, hashing, and key mistakes' },
  { name: 'Forensics', note: 'disk, memory, and traffic analysis' },
  { name: 'Reverse engineering', note: 'reading and understanding binaries' },
  { name: 'Binary exploitation (pwn)', note: 'memory-corruption and control-flow bugs' },
  { name: 'OSINT', note: 'open source intelligence gathering' },
  { name: 'Miscellaneous', note: 'scripting, recon, and everything else' },
];

const structure = [
  'Challenge, event, category, and difficulty',
  'Goal and initial observations',
  'Enumeration and recon',
  'Failed attempts (the useful part)',
  'Breakthrough and solution summary',
  'Defensive takeaway',
  'Tools used and lessons learned',
];
---

<BaseLayout
  title="CTF Writeups"
  description="Capture the Flag writeups by Derek Wei: offensive-security methodology from National Cyber League, BYU CTF, RowdyCon, and other authorized competitions."
>
  <PageHeader
    kicker="~/ctf"
    title="CTF Writeups"
    lede="Offensive-security methodology from Capture the Flag competitions, written to learn in public: reasoning and approach over flag spoilers."
  />

  <section class="py-10" aria-labelledby="about-ctf">
    <h2 id="about-ctf" class="font-mono text-sm uppercase tracking-[0.15em] text-faint">
      <span class="text-accent" aria-hidden="true">##</span> What is a CTF?
    </h2>
    <div class="mt-4 max-w-2xl space-y-3 text-sm leading-relaxed text-muted">
      <p>
        A Capture the Flag (CTF) is a legal, sanctioned competition where players solve
        security challenges to recover hidden tokens called flags. Everything runs against
        infrastructure the organizers set up for exactly that purpose, so it is a safe way
        to practice offensive techniques without touching real systems.
      </p>
      <p>
        These writeups follow a red-team learning approach: enumerate, form a hypothesis,
        test it, and document what worked and what did not. They describe only authorized
        practice. There are no live flags, no unauthorized targets, and no guidance for
        acting against systems you do not own or have explicit permission to test. Where an
        offensive finding has a clear defensive lesson, the writeup calls it out.
      </p>
    </div>
  </section>

  <section class="py-10" aria-labelledby="published">
    <h2 id="published" class="font-mono text-sm uppercase tracking-[0.15em] text-faint">
      <span class="text-accent" aria-hidden="true">##</span> Published writeups
    </h2>
    {
      writeups.length > 0 ? (
        <ul class="mt-5 grid gap-4 sm:grid-cols-2" role="list">
          {writeups.map((entry) => (
            <Card
              href={`/ctf/${entry.id}/`}
              title={entry.data.title}
              description={entry.data.description}
              meta={entry.data.event}
              tags={[
                entry.data.category,
                ...(entry.data.difficulty ? [entry.data.difficulty] : []),
                ...entry.data.tags,
              ]}
            />
          ))}
        </ul>
      ) : (
        <div class="panel mt-5 p-6">
          <p class="text-sm leading-relaxed text-muted">
            Writeups are being prepared and sanitized before publishing. The goal is to
            document methodology and reasoning, dead ends included, not just flags. They will
            appear here as they are finished.
          </p>
          <p
            id="competed-events"
            class="mt-6 font-mono text-xs uppercase tracking-wider text-faint"
          >
            Events I have competed in
          </p>
          <ul
            role="list"
            aria-labelledby="competed-events"
            class="mt-2 grid gap-1.5 sm:grid-cols-2"
          >
            {COMPETITIONS.map((c) => (
              <li class="font-mono text-sm text-muted">
                <span class="text-accent" aria-hidden="true">
                  -
                </span>{' '}
                {c.name} <span class="text-faint"> ({c.kind})</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="py-10" aria-labelledby="categories">
    <h2 id="categories" class="font-mono text-sm uppercase tracking-[0.15em] text-faint">
      <span class="text-accent" aria-hidden="true">##</span> Categories
    </h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2" role="list">
      {
        categories.map((cat) => (
          <li class="panel flex flex-col gap-1 p-4">
            <span class="font-mono text-sm text-accent">{cat.name}</span>
            <span class="text-xs text-muted">{cat.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="py-10" aria-labelledby="how-i-write">
    <h2 id="how-i-write" class="font-mono text-sm uppercase tracking-[0.15em] text-faint">
      <span class="text-accent" aria-hidden="true">##</span> How I structure a writeup
    </h2>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
      Each writeup follows the same outline so the reasoning stays easy to follow:
    </p>
    <ol
      class="mt-4 max-w-2xl list-decimal space-y-1.5 pl-5 text-sm leading-relaxed text-muted marker:font-mono marker:text-accent"
    >
      {structure.map((step) => <li>{step}</li>)}
    </ol>
  </section>
</BaseLayout>
