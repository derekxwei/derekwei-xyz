---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const items = [
  {
    title: 'Interning with the CyberTexas Foundation',
    body: "Working as a cybersecurity summer camp intern through July: helping deliver hands-on security training to area students at St. Mary's University, building VM lab exercises, and supporting live classroom sessions.",
    href: '/resume/',
    linkLabel: 'Resume',
  },
  {
    title: 'Getting ready for UTSA',
    body: 'Starting the B.S. Cybersecurity program in the Honors College at The University of Texas at San Antonio this fall, with a planned minor in AI/Data Science.',
    href: undefined,
    linkLabel: undefined,
  },
  {
    title: 'Studying for the HTB CPTS',
    body: 'Working through the Hack The Box Certified Penetration Testing Specialist path, with the AWS Certified AI Practitioner also in progress.',
    href: undefined,
    linkLabel: undefined,
  },
  {
    title: 'Looking for internship opportunities',
    body: 'Seeking cybersecurity internships for the school year and beyond, especially penetration testing, red-team, or security analyst roles.',
    href: '/contact/',
    linkLabel: 'Get in touch',
  },
  {
    title: 'Building out the offensive security lab',
    body: 'Expanding an authorized home lab for penetration testing practice and CTF challenges: local virtualization, disposable target VMs, and GPU-assisted password cracking.',
    href: '/lab/',
    linkLabel: 'Lab',
  },
  {
    title: 'Turning CTF results into writeups',
    body: 'Writing up challenges from this season (National Cyber League, BYU CTF, THEM?!CTF, and others) while the details are fresh.',
    href: '/ctf/',
    linkLabel: 'CTF writeups',
  },
];
---

<BaseLayout
  title="Now"
  description="What Derek Wei is focused on right now: starting UTSA's B.S. Cybersecurity program, CPTS preparation, penetration testing lab build-out, and CTF competition."
>
  <PageHeader
    kicker="~/now"
    title="Now"
    lede="What I'm focused on at the moment: the short list, kept current."
  >
    <p class="mt-4 font-mono text-xs text-faint">Last updated: July 9, 2026</p>
  </PageHeader>

  <!-- Update this page every month or two; a stale /now page is worse than none. -->

  <section class="py-10">
    <h2 class="sr-only">Current focus</h2>
    <ul class="grid gap-4" role="list">
      {
        items.map((item) => (
          <li class="panel p-5">
            <h3 class="font-mono text-sm text-ink">{item.title}</h3>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{item.body}</p>
            {item.href && (
              <p class="mt-3">
                <a href={item.href} class="link font-mono text-xs">
                  {item.linkLabel} &rarr;
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ul>
    <p class="mt-8 max-w-2xl text-xs leading-relaxed text-faint">
      This is a <a href="https://nownownow.com/about" class="link" rel="noopener noreferrer">now page</a>:
      a snapshot of current focus rather than a feed. If it's been more than a couple of
      months since the date above, ask me what changed.
    </p>
  </section>
</BaseLayout>
