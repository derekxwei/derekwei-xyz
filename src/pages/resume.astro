---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import {
  SITE,
  CONTACT,
  EDUCATION,
  CERTIFICATIONS,
  STACKABLE_CERTIFICATIONS,
  STACKABLE_NOTE,
  CREDLY_PROFILE,
  CERT_ROADMAP,
  CORE_AREAS,
  COMPETITIONS,
  EXPERIENCE,
  SCHOLARSHIPS,
  SKILL_GROUPS,
  LEADERSHIP,
} from '../consts';

// Empty tiers are hidden so an earned credential leaving the roadmap does not
// leave a blank entry behind.
const roadmap = [
  { label: 'In progress', items: CERT_ROADMAP.inProgress as readonly string[] },
  { label: 'Next', items: CERT_ROADMAP.next as readonly string[] },
  { label: 'Planned', items: CERT_ROADMAP.planned as readonly string[] },
].filter((tier) => tier.items.length > 0);

const description =
  'Resume of Derek Wei: UTSA B.S. Cybersecurity Honors student focused on penetration testing and CTF, 5x CompTIA certified, preparing for the CPTS.';

// A placement reads faster when the rank leads. This split is display only:
// the captured rank is rendered immediately before the untouched remainder of
// the same string, so the row still shows the recorded result verbatim. If a
// result does not start with a placement, it renders whole with no rank.
const splitResult = (result?: string) => {
  if (!result) return { rank: null, rest: null };
  const m = result.match(/^(\d+(?:st|nd|rd|th))\b/);
  return m ? { rank: m[1], rest: result.slice(m[1].length) } : { rank: null, rest: result };
};

const placed = COMPETITIONS.filter((c) => c.result);
const unplaced = COMPETITIONS.filter((c) => !c.result);

// Only surface the download button when the file is actually present in public/.
const resumePdf = '/Derek_Wei_Resume_Public.pdf';
const resumePdfExists = existsSync('public/Derek_Wei_Resume_Public.pdf');
---

<BaseLayout title="Resume" description={description}>
  <!-- One connected masthead: who, what, how to take it away, and how to make
       contact. Previously these were three detached blocks with a large gap. -->
  <header class="max-w-mid pt-10 sm:pt-14">
    <p class="kicker">~/resume</p>
    <div
      class="mt-2 flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between lg:gap-12"
    >
      <div>
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Resume</h1>
        <p class="mt-3 text-lg leading-relaxed text-prose-body">
          Education, certifications, competition results, and experience.
          Seeking cybersecurity internships.
        </p>
      </div>
      <div class="print-hidden flex shrink-0 flex-wrap items-center gap-3">
        {
          resumePdfExists && (
            <a href={resumePdf} class="btn btn-primary" download>
              Download PDF
            </a>
          )
        }
        <button
          id="print-btn"
          class:list={['btn', resumePdfExists ? 'btn-ghost' : 'btn-primary']}
          type="button">Print</button
        >
      </div>
    </div>

    <!-- Contact strip: a rule, not a panel. It belongs to the masthead. -->
    <div class="mt-7 border-t border-line pt-4">
      <ul
        role="list"
        class="flex flex-col gap-x-6 gap-y-1.5 font-mono text-sm sm:flex-row sm:flex-wrap sm:items-center"
      >
        <li><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li>
          <a
            class="link"
            href={`tel:${CONTACT.phoneE164}`}
            aria-label={`Call Derek Wei at ${CONTACT.phoneDisplay}, his professional Google Voice number`}
            >{CONTACT.phoneDisplay}</a
          >
        </li>
        <li><a class="link" href={SITE.linkedin} rel="noopener noreferrer">LinkedIn</a></li>
        <li>
          <a class="link" href={SITE.github} rel="noopener noreferrer">github.com/derekxwei</a>
        </li>
        <li class="text-muted">{SITE.location}</li>
      </ul>
      <p class="mt-3 font-mono text-xs leading-relaxed text-muted">
        {SITE.clearance}
      </p>
      <p class="mt-1.5 font-mono text-xs leading-relaxed text-faint">
        5x CompTIA certified (CySA+, PenTest+, Security+, Network+, ITF+)
        &middot; AWS Certified AI Practitioner &middot; CTF competitor &middot;
        preparing for the CPTS
      </p>
      <p class="print-hidden mt-3 font-mono text-[11px] text-faint">
        Print output strips site chrome and renders dark on white.
      </p>
    </div>
  </header>

  <SectionHead width="mid" eyebrow="Profile" title="Summary" id="summary" tight>
    <p class="mt-5 leading-relaxed text-prose-body">
      Cybersecurity student working toward offensive security: penetration
      testing, Capture the Flag competition, and the defensive analysis that
      connects findings back to real systems. Placed 1st of 1,692 teams in the
      National Cyber League High School division, with nearly four years
      supporting cybersecurity labs across Windows and Linux. Bilingual in
      English and Mandarin Chinese. Seeking cybersecurity internships.
    </p>
  </SectionHead>

  <SectionHead width="mid" eyebrow="Education" title="Education" id="education">
    <ul role="list" class="ledger mt-6 max-w-mid">
      {
        EDUCATION.map((entry) => (
          <li class="lrow sm:grid-cols-[minmax(0,1fr)_auto]">
            <div>
              <p class="lname">{entry.school}</p>
              <p class="mt-0.5 text-sm text-muted">{entry.program}</p>
              {entry.note && <p class="mt-1 text-sm text-faint">{entry.note}</p>}
            </div>
            <p class="lnum sm:pt-1 sm:text-right">{entry.detail}</p>
          </li>
        ))
      }
    </ul>
  </SectionHead>

  <SectionHead width="mid" eyebrow="Recognition" title="Scholarships" id="scholarships">
    <ul role="list" class="ledger mt-6 max-w-mid">
      {
        SCHOLARSHIPS.map((s) => (
          <li class="lrow sm:grid-cols-[minmax(0,1fr)_auto_5rem]">
            <p class="lname">{s.name}</p>
            <p class="lmeta sm:pt-1 sm:text-right">{s.institution}</p>
            <p class="lnum sm:pt-1 sm:text-right">{s.year}</p>
          </li>
        ))
      }
    </ul>
  </SectionHead>

  <SectionHead width="mid"
    eyebrow="Credentials"
    title="Certifications"
    id="certifications"
    note="Each credential links to its public Credly badge."
  >
    <ul role="list" class="ledger mt-6 max-w-mid">
      {
        CERTIFICATIONS.map((cert) => (
          <li class="lrow sm:grid-cols-[minmax(0,1fr)_11rem_4rem]">
            <p class="lname">
              {cert.verifyUrl ? (
                <a
                  class="link"
                  href={cert.verifyUrl}
                  rel="noopener noreferrer"
                  aria-label={`${cert.name}: verify badge on Credly`}
                >
                  {cert.name}
                </a>
              ) : (
                <span>{cert.name}</span>
              )}
            </p>
            <p class="lmeta sm:pt-1">{cert.issuer}</p>
            <p class="lnum sm:pt-1 sm:text-right">{cert.year ?? ''}</p>
          </li>
        ))
      }
    </ul>

    <h3 class="eyebrow mt-8">CompTIA stackable certifications</h3>
    <ul role="list" class="ledger mt-3 max-w-mid">
      {
        STACKABLE_CERTIFICATIONS.map((cert) => (
          <li class="lrow py-2.5 sm:grid-cols-[minmax(0,1fr)_auto]">
            <p class="text-sm">
              {cert.verifyUrl ? (
                <a
                  class="link"
                  href={cert.verifyUrl}
                  rel="noopener noreferrer"
                  aria-label={`${cert.short}: verify the ${cert.name} badge on Credly`}
                >
                  {cert.name}
                </a>
              ) : (
                <span class="text-muted">{cert.name}</span>
              )}
            </p>
            <p class="lmeta sm:pt-0.5 sm:text-right">{cert.issuer}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-sm leading-relaxed text-muted">{STACKABLE_NOTE}</p>
    <p class="mt-4 font-mono text-xs">
      <a class="link" href={CREDLY_PROFILE} rel="noopener noreferrer">
        View all verified credentials on Credly
      </a>
    </p>

    <h3 class="eyebrow mt-8">Certification roadmap</h3>
    <ul role="list" class="ledger mt-3 max-w-mid">
      {
        roadmap.map((tier) => (
          <li class="lrow py-2.5 sm:grid-cols-[6rem_minmax(0,1fr)]">
            <p class="font-mono text-xs uppercase tracking-wider text-accent sm:pt-0.5">
              {tier.label}
            </p>
            <p class="text-sm leading-relaxed text-muted">{tier.items.join(', ')}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 font-mono text-xs text-faint">
      Roadmap items are goals in progress, not earned credentials.
    </p>
  </SectionHead>

  <SectionHead width="mid"
    eyebrow="Competitions"
    title="Competition results"
    id="competitions"
    note="Placements as recorded. Team results are stated as team results."
  >
    <ul role="list" class="ledger mt-6 max-w-mid">
      {
        placed.map((c) => {
          const { rank, rest } = splitResult(c.result);
          return (
            <li class="lrow sm:grid-cols-[4.5rem_minmax(0,1fr)]">
              <p class="rank sm:pt-0.5">{rank}</p>
              <div>
                <p class="lname">{c.name}</p>
                <p class="mt-0.5 text-sm leading-relaxed text-muted">
                  {rank}
                  {rest}
                </p>
                {c.writeup && (
                  <p class="mt-1.5 font-mono text-xs">
                    <a class="link" href={c.writeup.href}>
                      {c.writeup.label} &rarr;
                    </a>
                  </p>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
    {
      unplaced.length > 0 && (
        <p class="mt-4 text-sm leading-relaxed text-muted">
          Also competed in {unplaced.map((c) => c.name).join(' and ')}.
        </p>
      )
    }
  </SectionHead>

  <SectionHead width="mid" eyebrow="Writing" title="Selected technical writing" id="writing">
    <!-- The one published writeup gets an evidence treatment, not a card. -->
    <div class="mt-6 max-w-mid border-l-2 border-accent pl-5">
      <p class="eyebrow">BroncoCTF 2026 &middot; OSINT</p>
      <h3 class="mt-1.5 text-xl font-semibold tracking-tight">
        <a class="link no-underline hover:underline" href="/ctf/broncoctf-2026-ao-sint/"
          >AO-SINT: evidence-first game geolocation</a
        >
      </h3>
      <p class="mt-2 leading-relaxed text-prose-body">
        Used topography, architecture, map geometry, and sightline
        reconstruction to identify four Arcane Odyssey locations.
      </p>
      <p class="mt-2 font-mono text-xs text-muted">
        Team idktheflag placed 8th of 753 teams.
      </p>
      <p class="mt-4">
        <a class="btn btn-ghost" href="/ctf/broncoctf-2026-ao-sint/">Read the writeup</a>
      </p>
    </div>
  </SectionHead>

  <SectionHead width="mid" eyebrow="Experience" title="Relevant experience" id="experience">
    <!-- Dated timeline: the date column stays put so roles scan vertically. -->
    <ol role="list" class="ledger mt-6 max-w-mid">
      {
        EXPERIENCE.map((job) => (
          <li class="lrow py-6 sm:grid-cols-[minmax(0,1fr)_auto]">
            <div class="sm:col-start-1">
              <h3 class="text-lg font-semibold tracking-tight text-ink">{job.role}</h3>
              <p class="mt-0.5 text-muted">{job.org}</p>
            </div>
            <p class="lnum sm:col-start-2 sm:row-start-1 sm:pt-2 sm:text-right">
              {job.period}
            </p>
            <ul
              role="list"
              class="mt-3 space-y-1.5 text-sm leading-relaxed text-muted sm:col-span-2"
            >
              {job.bullets.map((bullet) => (
                <li class="relative pl-4 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2 before:bg-accent">
                  {bullet}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </SectionHead>

  <SectionHead width="mid" eyebrow="Capabilities" title="Technical skills" id="skills">
    <!-- A structured inventory, not a pill wall. No ratings or proficiency
         labels: the credentials and competition results carry that weight. -->
    <dl class="ledger mt-6 max-w-mid">
      <div class="lrow sm:grid-cols-[11rem_minmax(0,1fr)]">
        <dt class="eyebrow sm:pt-1">Focus areas</dt>
        <dd class="text-sm leading-relaxed text-muted">{CORE_AREAS.join(', ')}</dd>
      </div>
      {
        SKILL_GROUPS.map((group) => (
          <div class="lrow sm:grid-cols-[11rem_minmax(0,1fr)]">
            <dt class="eyebrow sm:pt-1">{group.label}</dt>
            <dd class="text-sm leading-relaxed text-muted">{group.items}</dd>
          </div>
        ))
      }
    </dl>
  </SectionHead>

  <SectionHead width="mid" eyebrow="Leadership" title="Leadership and activities" id="leadership">
    <ul role="list" class="ledger mt-6 max-w-mid">
      {
        LEADERSHIP.map((item) => (
          <li class="lrow sm:grid-cols-[minmax(0,1fr)_auto]">
            <div>
              <p class="lname">{item.role}</p>
              <p class="mt-0.5 text-sm leading-relaxed text-muted">{item.detail}</p>
            </div>
            <p class="lnum sm:pt-1 sm:text-right">{item.period}</p>
          </li>
        ))
      }
    </ul>
  </SectionHead>
</BaseLayout>

<script>
  const printBtn = document.getElementById('print-btn') as HTMLButtonElement | null;
  printBtn?.addEventListener('click', () => {
    window.print();
  });
</script>

<!--
  This is the public web resume. The only phone number allowed here is the
  intentionally public Google Voice number in src/consts.ts (CONTACT). Never
  add a carrier number, home address, date of birth, or student IDs. The
  maintained .docx master lives off the repo. Keep placements and dates in
  sync with src/consts.ts.
-->
