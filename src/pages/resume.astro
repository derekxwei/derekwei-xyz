---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  SITE,
  CONTACT,
  EDUCATION,
  CERTIFICATIONS,
  STACKABLE_CERTIFICATIONS,
  STACKABLE_NOTE,
  CREDLY_PROFILE,
  CERT_ROADMAP,
  CORE_AREAS,
  COMPETITIONS,
  EXPERIENCE,
  SCHOLARSHIPS,
  SKILL_GROUPS,
  LEADERSHIP,
} from '../consts';

// Empty tiers are hidden so an earned credential leaving the roadmap does not
// leave a blank card behind.
const roadmap = [
  { label: 'In progress', items: CERT_ROADMAP.inProgress as readonly string[] },
  { label: 'Next', items: CERT_ROADMAP.next as readonly string[] },
  { label: 'Planned', items: CERT_ROADMAP.planned as readonly string[] },
].filter((tier) => tier.items.length > 0);

const description =
  'Resume of Derek Wei: incoming UTSA B.S. Cybersecurity Honors student focused on penetration testing and CTF, 5x CompTIA certified, preparing for the CPTS.';

const competitionNames = COMPETITIONS.map((c) => c.name).join(', ');

// Only surface the download button when the file is actually present in public/.
const resumePdf = '/Derek_Wei_Resume_Public.pdf';
const resumePdfExists = existsSync('public/Derek_Wei_Resume_Public.pdf');
---

<BaseLayout title="Resume" description={description}>
  <PageHeader
    kicker="~/resume"
    title="Resume"
    lede="Education, certifications, competition results, and experience. Formatted to print cleanly."
  />

  <div
    class="print-hidden flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-line py-5"
  >
    {
      resumePdfExists && (
        <a href={resumePdf} class="btn btn-primary" download>
          Download PDF
        </a>
      )
    }
    <button id="print-btn" class:list={['btn', resumePdfExists ? 'btn-ghost' : 'btn-primary']} type="button">
      Print / save as PDF
    </button>
    <p class="font-mono text-xs text-faint">
      // print-friendly: site chrome is stripped and output renders dark-on-white
    </p>
  </div>

  <section class="py-10" aria-label="Contact information">
    <div class="panel p-5">
      <ul
        role="list"
        class="flex flex-col gap-2 font-mono text-sm sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6"
      >
        <li>
          <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>
          <a
            class="link"
            href={`tel:${CONTACT.phoneE164}`}
            aria-label={`Call Derek Wei at ${CONTACT.phoneDisplay}, his professional Google Voice number`}
            >{CONTACT.phoneDisplay}</a
          >
        </li>
        <li>
          <a class="link" href={SITE.linkedin} rel="noopener noreferrer">LinkedIn</a>
        </li>
        <li class="text-muted">{SITE.location}</li>
        <li class="w-full text-muted sm:w-auto">{SITE.clearance}</li>
      </ul>
      <p class="mt-4 border-t border-line pt-4 font-mono text-xs leading-relaxed text-muted">
        5x CompTIA certified (CySA+, PenTest+, Security+, Network+, ITF+)
        &middot; AWS Certified AI Practitioner &middot; CTF competitor &middot;
        preparing for the CPTS
      </p>
    </div>
  </section>

  <section class="py-10" aria-labelledby="summary-heading">
    <h2
      id="summary-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Summary
    </h2>
    <p class="mt-6 max-w-2xl leading-relaxed text-muted">
      Incoming B.S. Cybersecurity Honors student focused on red-team
      fundamentals, penetration testing labs, and Capture the Flag competition,
      backed by five CompTIA certifications and hands-on security tooling. Nearly
      four years supporting cybersecurity labs and troubleshooting Windows and
      Linux systems, now preparing for the Hack The Box Certified Penetration
      Testing Specialist (CPTS). Blue-team literacy from CySA+ supports the
      offensive work by connecting findings back to defense. Seeking
      cybersecurity internships.
    </p>
  </section>

  <section class="py-10" aria-labelledby="core-areas-heading">
    <h2
      id="core-areas-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Core areas
    </h2>
    <ul class="mt-6 flex flex-wrap gap-2" role="list">
      {
        CORE_AREAS.map((area) => (
          <li class="rounded-md border border-line bg-panel-2 px-3 py-1.5 font-mono text-xs text-muted">
            {area}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="py-10" aria-labelledby="certifications-heading">
    <h2
      id="certifications-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Certifications
    </h2>
    <ul role="list" class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        CERTIFICATIONS.map((cert) => (
          <li class="panel p-4">
            <p class="text-sm font-medium">
              {cert.verifyUrl ? (
                <a
                  class="link"
                  href={cert.verifyUrl}
                  rel="noopener noreferrer"
                  aria-label={`${cert.name}: verify badge on Credly`}
                >
                  {cert.name}
                </a>
              ) : (
                <span class="text-ink">{cert.name}</span>
              )}
            </p>
            <p class="mt-1 font-mono text-xs text-faint">
              {cert.issuer}
              {cert.year && ` · ${cert.year}`}
            </p>
          </li>
        ))
      }
    </ul>

    <h3 class="mt-8 font-mono text-xs uppercase tracking-[0.15em] text-faint">
      CompTIA stackable certifications
    </h3>
    <ul role="list" class="mt-3 flex flex-wrap gap-2">
      {
        STACKABLE_CERTIFICATIONS.map((cert) => (
          <li class="rounded-md border border-line bg-panel-2 px-3 py-1.5 font-mono text-xs">
            {cert.verifyUrl ? (
              <a
                class="link"
                href={cert.verifyUrl}
                rel="noopener noreferrer"
                aria-label={`${cert.short}: verify the ${cert.name} badge on Credly`}
              >
                {cert.short}
              </a>
            ) : (
              <span class="text-muted">{cert.short}</span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{STACKABLE_NOTE}</p>
    <p class="mt-3 font-mono text-xs">
      <a class="link" href={CREDLY_PROFILE} rel="noopener noreferrer">
        View all verified credentials on Credly
      </a>
    </p>

    <h3 class="mt-8 font-mono text-xs uppercase tracking-[0.15em] text-faint">
      Current certification roadmap
    </h3>
    <dl class="mt-3 grid gap-3 sm:grid-cols-3">
      {
        roadmap.map((tier) => (
          <div class="panel p-4">
            <dt class="font-mono text-xs uppercase tracking-wider text-accent">{tier.label}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-muted">
              {tier.items.join(', ')}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-3 font-mono text-xs text-faint">
      Roadmap items are goals in progress, not earned credentials.
    </p>
  </section>

  <section class="py-10" aria-labelledby="competitions-heading">
    <h2
      id="competitions-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Competition experience
    </h2>
    <p class="mt-6 max-w-2xl leading-relaxed text-muted">
      Competition experience includes {competitionNames}. Detailed placements and
      results are on the <a href="/achievements/" class="link">achievements page</a>.
    </p>
  </section>

  <section class="py-10" aria-labelledby="writing-heading">
    <h2
      id="writing-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Selected technical writing
    </h2>
    <div class="panel mt-6 p-5">
      <div
        class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
      >
        <h3 class="font-medium text-ink">AO-SINT: evidence-first game geolocation</h3>
        <p class="shrink-0 font-mono text-xs text-faint">
          BroncoCTF 2026 &middot; OSINT
        </p>
      </div>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
        Used topography, architecture, map geometry, and sightline reconstruction
        to identify four Arcane Odyssey locations. Team idktheflag placed 8th of
        753 teams.
      </p>
      <p class="mt-3 font-mono text-xs">
        <a class="link" href="/ctf/broncoctf-2026-ao-sint/">Read the AO-SINT writeup &rarr;</a>
      </p>
    </div>
  </section>

  <section class="py-10" aria-labelledby="experience-heading">
    <h2
      id="experience-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Experience
    </h2>
    <ul role="list" class="mt-6 divide-y divide-line">
      {
        EXPERIENCE.map((job) => (
          <li class="py-6 first:pt-0 last:pb-0">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <div>
                <h3 class="font-medium text-ink">{job.role}</h3>
                <p class="text-sm text-muted">{job.org}</p>
              </div>
              <p class="shrink-0 font-mono text-xs text-faint">{job.period}</p>
            </div>
            <ul
              role="list"
              class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted marker:text-accent"
            >
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="py-10" aria-labelledby="education-heading">
    <h2
      id="education-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Education
    </h2>
    <ul role="list" class="mt-6 divide-y divide-line">
      {
        EDUCATION.map((entry) => (
          <li class="py-4 first:pt-0 last:pb-0">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <div>
                <p class="font-medium text-ink">{entry.school}</p>
                <p class="text-sm text-muted">{entry.program}</p>
              </div>
              <p class="shrink-0 font-mono text-xs text-faint">{entry.detail}</p>
            </div>
            {entry.note && <p class="mt-2 text-sm text-muted">{entry.note}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="py-10" aria-labelledby="scholarships-heading">
    <h2
      id="scholarships-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Scholarships
    </h2>
    <ul role="list" class="mt-6 divide-y divide-line">
      {
        SCHOLARSHIPS.map((s) => (
          <li class="py-4 first:pt-0 last:pb-0">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <div>
                <p class="font-medium text-ink">{s.name}</p>
                <p class="text-sm text-muted">{s.institution}</p>
              </div>
              <p class="shrink-0 font-mono text-xs text-faint">
                {s.amount && `${s.amount} · `}
                {s.year}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="py-10" aria-labelledby="skills-heading">
    <h2
      id="skills-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Technical skills
    </h2>
    <dl class="mt-6 grid gap-4">
      {
        SKILL_GROUPS.map((group) => (
          <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
            <dt class="shrink-0 font-mono text-xs uppercase tracking-wider text-faint sm:w-52 sm:pt-0.5">
              {group.label}
            </dt>
            <dd class="text-sm leading-relaxed text-muted">{group.items}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="py-10" aria-labelledby="leadership-heading">
    <h2
      id="leadership-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Leadership &amp; activities
    </h2>
    <ul role="list" class="mt-6 grid gap-4">
      {
        LEADERSHIP.map((item) => (
          <li class="flex flex-col gap-1">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <p class="text-sm font-medium text-ink">{item.role}</p>
              <p class="shrink-0 font-mono text-xs text-faint">{item.period}</p>
            </div>
            <p class="text-sm leading-relaxed text-muted">{item.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  const printBtn = document.getElementById('print-btn') as HTMLButtonElement | null;
  printBtn?.addEventListener('click', () => {
    window.print();
  });
</script>

<!--
  This is the public web resume. The only phone number allowed here is the
  intentionally public Google Voice number in src/consts.ts (CONTACT). Never
  add a carrier number, home address, date of birth, or student IDs. The
  maintained .docx master lives off the repo. Keep placements and dates in
  sync with src/consts.ts.
-->
