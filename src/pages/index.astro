---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CERTIFICATIONS, EXPERIENCE } from '../consts';

// Homepage holds six sections at most: hero, selected work, experience
// snapshot, verified credentials, current direction, contact. Full detail
// lives on the destination pages; the homepage shows outcome, evidence, link.

const comptia = CERTIFICATIONS.filter((c) => c.issuer === 'CompTIA');

const selectedWork = [
  {
    title: 'AO-SINT: evidence-first game geolocation',
    href: '/ctf/broncoctf-2026-ao-sint/',
    meta: 'BroncoCTF 2026 · OSINT',
    description:
      'Used topography, architecture, map geometry, and sightlines to identify four Arcane Odyssey locations from four screenshots. Team idktheflag placed 8th of 753 teams.',
    image: '/images/ctf/broncoctf-2026-ao-sint/location-1-ierochos.webp',
    alt: 'Arcane Odyssey character standing on a high narrow rock pillar with several distant islands visible through severe weather.',
    imageFit: 'cover',
    wide: true,
  },
  {
    title: 'CPTS study notes pipeline',
    href: '/projects/cpts-notes-pipeline/',
    meta: 'Project · in progress',
    description:
      'A Claude and Obsidian workflow that turns study material into structured notes and review artifacts, with human accuracy review. Preparation for the Certified Penetration Testing Specialist exam, which is not yet held.',
    image: '/images/architecture/cpts-notes-pipeline.svg',
    alt: 'Pipeline diagram from authorized study material through Claude processing and human accuracy review into an Obsidian vault.',
    imageFit: 'contain',
    wide: false,
  },
  {
    title: 'Secure travel network',
    href: '/projects/secure-travel-network/',
    meta: 'Project · network security',
    description:
      'A privacy-aware travel setup: trusted personal devices behind a GL.iNet Opal travel router with an encrypted VPN gateway over public Wi-Fi.',
    image: '/images/architecture/secure-travel-network.svg',
    alt: 'Network diagram of trusted devices connecting through a travel router and encrypted VPN gateway to public Wi-Fi and the internet.',
    imageFit: 'contain',
    wide: false,
  },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: 'Cybersecurity Student',
  sameAs: [SITE.linkedin],
  alumniOf: {
    '@type': 'HighSchool',
    name: 'MacArthur High School',
  },
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'The University of Texas at San Antonio',
  },
};
---

<BaseLayout title="Derek Wei">
  <!-- 1. Hero -->
  <section class="relative border-b border-line">
    <div class="bg-grid hero-fade absolute inset-0" aria-hidden="true"></div>
    <div class="relative py-16 sm:py-24">
      <p class="font-mono text-sm text-accent">Cybersecurity student</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
        Derek Wei
      </h1>
      <p class="mt-4 max-w-xl leading-relaxed text-muted">
        Incoming B.S. Cybersecurity Honors student at The University of Texas
        at San Antonio, focused on offensive security fundamentals, Capture the
        Flag competition, and practical security tooling.
      </p>
      <p
        class="mt-5 inline-flex items-center gap-2 rounded-md border border-line bg-panel-2 px-3 py-1.5 font-mono text-xs text-muted"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"
        ></span>
        {SITE.clearance}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href="#selected-work" class="btn btn-primary">View selected work</a>
        <a href="/Derek_Wei_Resume_Public.pdf" class="btn btn-ghost" download>
          Download resume (PDF)
        </a>
        <a href="/contact/" class="link font-mono text-sm">Contact →</a>
      </div>
    </div>
  </section>

  <!-- 2. Selected work -->
  <section class="py-12" aria-labelledby="selected-work">
    <h2
      id="selected-work"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Selected work
    </h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2" role="list">
      {
        selectedWork.map((item) => (
          <li
            class:list={[
              'panel group relative overflow-hidden transition-colors hover:border-line-2',
              item.wide && 'sm:col-span-2',
            ]}
          >
            <img
              src={item.image}
              alt={item.alt}
              loading="lazy"
              class:list={[
                'w-full border-b border-line',
                item.wide ? 'h-56 sm:h-72' : 'h-48',
                item.imageFit === 'cover'
                  ? 'object-cover'
                  : 'bg-panel-2 object-contain p-4',
              ]}
            />
            <div class="p-5">
              <p class="font-mono text-xs text-faint">{item.meta}</p>
              <h3 class="mt-1.5 text-base font-medium leading-snug">
                <a href={item.href} class="card-link">
                  {item.title}
                </a>
              </h3>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
                {item.description}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 3. Experience snapshot -->
  <section class="border-t border-line py-12" aria-labelledby="experience-snapshot">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2
        id="experience-snapshot"
        class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
      >
        <span class="text-accent" aria-hidden="true">##</span> Experience
      </h2>
      <a href="/resume/" class="link font-mono text-sm">Full resume →</a>
    </div>
    <ul class="mt-5 divide-y divide-line" role="list">
      {
        EXPERIENCE.map((job) => (
          <li class="flex flex-col gap-1 py-3.5 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <p class="text-sm text-ink">
              {job.role}
              <span class="text-muted"> · {job.org}</span>
            </p>
            <p class="shrink-0 font-mono text-xs text-faint">{job.period}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 4. Verified credentials -->
  <section class="border-t border-line py-12" aria-labelledby="credentials">
    <h2
      id="credentials"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Verified credentials
    </h2>
    <p class="mt-5 font-mono text-sm leading-relaxed text-muted">
      5x CompTIA certified:{' '}
      {
        comptia.map((cert, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            {cert.verifyUrl ? (
              <a
                href={cert.verifyUrl}
                class="link"
                rel="noopener noreferrer"
                aria-label={`${cert.short}: verify badge on Credly`}
              >
                {cert.short}
              </a>
            ) : (
              cert.short
            )}
          </>
        ))
      }
    </p>
    <p class="mt-3 font-mono text-xs">
      <a href="/achievements/" class="link">View all verified credentials →</a>
    </p>
  </section>

  <!-- 5. Current direction -->
  <section class="border-t border-line py-12" aria-labelledby="current-direction">
    <h2
      id="current-direction"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Current direction
    </h2>
    <ul class="mt-5 grid max-w-2xl gap-2.5" role="list">
      {
        [
          'Certified Penetration Testing Specialist (CPTS) preparation',
          'Beginning UTSA Cybersecurity Honors coursework',
          'Capture the Flag practice and practical portfolio development',
        ].map((item) => (
          <li class="flex gap-2 text-sm leading-relaxed text-muted">
            <span class="text-accent" aria-hidden="true">
              -
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 6. Contact -->
  <section class="border-t border-line py-12" aria-labelledby="contact-cta">
    <h2
      id="contact-cta"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Contact
    </h2>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">
      Open to cybersecurity internships, CTF collaboration, and security
      projects.
    </p>
    <p class="mt-5">
      <a href="/contact/" class="btn btn-primary">Contact Derek</a>
    </p>
  </section>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
</BaseLayout>

<style>
  .hero-fade {
    mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.9) 0%,
      rgb(0 0 0 / 0.35) 60%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.9) 0%,
      rgb(0 0 0 / 0.35) 60%,
      transparent 100%
    );
  }
</style>
