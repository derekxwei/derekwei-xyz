---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Section from '../components/Section.astro';
import {
  SITE,
  CONTACT,
  CERTIFICATIONS,
  CERT_ROADMAP,
  COMPETITIONS,
  EXPERIENCE,
} from '../consts';

// Supporting work on the homepage is chosen here rather than by the `featured`
// frontmatter flag, because the two entries that support the AO-SINT feature
// are a deliberate editorial pair. Nothing in the collections is edited.
const SUPPORTING_IDS = ['cpts-notes-pipeline', 'secure-travel-network'];

const allProjects = await getCollection('projects', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);
const supporting = SUPPORTING_IDS.map((id) =>
  allProjects.find((p) => p.id === id)
).filter((p) => p !== undefined);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

// The BroncoCTF placement is a team result and is rendered exactly as recorded
// in consts.ts. It is never restated as an individual placement.
const broncoCtf = COMPETITIONS.find((c) => c.name === 'BroncoCTF 2026');

const comptia = CERTIFICATIONS.filter((c) => c.issuer === 'CompTIA');
const aws = CERTIFICATIONS.find((c) => c.short === 'AWS AI Practitioner');
const mos = CERTIFICATIONS.find((c) => c.short === 'MOS Word');

// Same three items the About page states, including the qualifier that the
// CPTS is being prepared for and is not currently held.
const direction = [
  { text: 'Beginning UTSA Cybersecurity Honors coursework', note: null },
  {
    text: `Preparing for the ${CERT_ROADMAP.inProgress[0]}`,
    note: 'in progress, not currently held',
  },
  {
    text: 'Building practical projects and publishing Capture the Flag writeups',
    note: null,
  },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: 'Cybersecurity Student',
  sameAs: [SITE.linkedin],
  alumniOf: {
    '@type': 'HighSchool',
    name: 'MacArthur High School',
  },
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'The University of Texas at San Antonio',
  },
};
---

<BaseLayout title="Derek Wei">
  <!-- Hero -->
  <section class="relative" aria-labelledby="hero-heading">
    <div class="bg-grid hero-fade absolute inset-x-0 top-0 h-96" aria-hidden="true"></div>
    <div class="relative py-16 sm:py-20 lg:py-24">
      <p class="kicker normal-case">$ whoami</p>
      <h1
        id="hero-heading"
        class="mt-3 text-5xl font-semibold tracking-tight sm:text-6xl lg:text-[4.25rem] lg:leading-[1.02]"
      >
        Derek Wei
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-prose-body sm:text-xl">
        B.S. Cybersecurity student in the Honors College at The
        University of Texas at San Antonio, focused on red-team fundamentals,
        penetration testing labs, Capture the Flag methodology, and practical
        security tooling. Preparing for the Certified Penetration Testing
        Specialist (CPTS).
      </p>
      <p class="mt-5 font-mono text-xs leading-relaxed text-faint">
        5x CompTIA certified (CySA+, PenTest+, Security+, Network+, ITF+)
        &middot; AWS Certified AI Practitioner &middot; graduate of the NEISD
        iCSI Cybersecurity Program, Class of 2026
      </p>
      <p
        class="mt-5 inline-flex items-center gap-2 rounded-md border border-line bg-panel-2 px-3 py-1.5 font-mono text-xs text-muted"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {SITE.clearance}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#selected-work" class="btn btn-primary">View selected work</a>
        <a href={CONTACT.resumePdf} class="btn btn-ghost">Download resume (PDF)</a>
        <a href="/contact/" class="link inline-flex min-h-11 items-center font-mono text-sm">Contact &rarr;</a>
      </div>
    </div>
  </section>

  <!-- 01 Evidence -->
  <Section
    id="selected-work"
    num="01"
    cat="Evidence"
    title="Selected work"
    note="Real work, each with its own writeup or project page."
  >
    <!-- AO-SINT is the dominant item: the widest image on the site, then the
         context, the team placement, the method, and the action. -->
    <div class="evidence-feature mt-8 max-w-evidence">
      <a href="/ctf/broncoctf-2026-ao-sint/" class="group block">
        <figure class="m-0">
          <img
            src="/images/ctf/broncoctf-2026-ao-sint/location-1-ierochos.webp"
            alt="Arcane Odyssey character standing on a high narrow rock pillar with several distant islands visible through severe weather."
            width="1600"
            height="717"
            loading="eager"
            decoding="async"
            class="evidence-frame w-full rounded-lg border border-line"
          />
          <figcaption class="mt-3 text-sm leading-relaxed text-muted">
            BroncoCTF 2026 challenge screenshot: the foreground pillar and
            multi-island sightline placed the character on Ierochos.
          </figcaption>
        </figure>
        <p class="kicker mt-8">BroncoCTF 2026 &middot; OSINT</p>
        <h3
          class="mt-2 text-2xl font-semibold tracking-tight transition-colors group-hover:text-accent sm:text-[1.75rem]"
        >
          AO-SINT: evidence-first game geolocation
        </h3>
      </a>
      <p class="mt-3 leading-relaxed text-prose-body">
        Used topography, architecture, map geometry, and sightline
        reconstruction to identify four Arcane Odyssey locations from four
        screenshots.
      </p>
      {
        broncoCtf?.result && (
          <p class="mt-3 font-medium text-accent">
            {broncoCtf.name}: {broncoCtf.result}
          </p>
        )
      }
      <p class="mt-6">
        <a href="/ctf/broncoctf-2026-ao-sint/" class="btn btn-primary">
          Read the writeup
        </a>
      </p>
    </div>

    <!-- Supporting work sits clearly below the feature. Both projects only
         have tall portrait diagrams, so neither gets a homepage thumbnail:
         squeezed into a wide crop they are unreadable. -->
    <div class="mt-14 max-w-evidence">
      <h3
        class="font-mono text-xs uppercase tracking-[0.16em] text-faint"
        id="supporting-work"
      >
        Supporting work
      </h3>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2" role="list">
        {
          supporting.map((project) => (
            <Card
              href={`/projects/${project.id}/`}
              title={project.data.title}
              description={project.data.description}
              meta={fmt(project.data.date)}
              tags={[...project.data.tags]}
              status={project.data.status}
            />
          ))
        }
      </ul>
      <p class="mt-5">
        <a href="/projects/" class="link font-mono text-sm">All projects &rarr;</a>
      </p>
    </div>
  </Section>

  <!-- 02 Experience -->
  <Section id="experience" num="02" cat="Experience" title="Relevant experience">
    <ul class="mt-8 max-w-mid" role="list">
      {
        EXPERIENCE.map((job) => (
          <li class="border-b border-line py-4 last:border-b-0">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <p class="font-medium text-ink">
                {job.role}
                <span class="font-normal text-muted"> &middot; {job.org}</span>
              </p>
              <span class="shrink-0 font-mono text-xs text-faint">{job.period}</span>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-5">
      <a href="/resume/" class="link font-mono text-sm">Full resume &rarr;</a>
    </p>
  </Section>

  <!-- 03 Credentials -->
  <Section id="credentials" num="03" cat="Credentials" title="Verified credentials">
    <div class="mt-8 max-w-mid space-y-3 leading-relaxed">
      <p class="text-muted">
        <strong class="font-medium text-ink">5x CompTIA certified:</strong>{' '}
        {
          comptia.map((cert, i) => (
            <>
              {i > 0 && <span class="text-faint" aria-hidden="true"> &middot; </span>}
              <a
                href={cert.verifyUrl}
                class="link"
                rel="noopener noreferrer"
                aria-label={`${cert.short}: verify badge on Credly`}
              >
                {cert.short}
              </a>
            </>
          ))
        }
      </p>
      <p class="text-muted">
        <strong class="font-medium text-ink">Also earned:</strong>{' '}
        {
          aws && (
            <a
              href={aws.verifyUrl}
              class="link"
              rel="noopener noreferrer"
              aria-label={`${aws.name}: verify badge on Credly`}
            >
              {aws.name}
            </a>
          )
        }
        <span class="text-faint" aria-hidden="true"> &middot; </span>
        {
          mos && (
            <a
              href={mos.verifyUrl}
              class="link"
              rel="noopener noreferrer"
              aria-label={`${mos.name}: verify badge on Credly`}
            >
              {mos.name}
            </a>
          )
        }
      </p>
    </div>
    <p class="mt-5">
      <a href="/achievements/" class="link font-mono text-sm">
        All verified credentials &rarr;
      </a>
    </p>
  </Section>

  <!-- 04 Direction -->
  <Section id="direction" num="04" cat="Direction" title="Current direction">
    <ul class="mt-8 grid max-w-measure gap-2.5" role="list">
      {
        direction.map((item) => (
          <li class="flex gap-2 leading-relaxed text-muted">
            <span class="text-accent" aria-hidden="true">
              -
            </span>
            <span>
              {item.text}
              {item.note && <span class="text-faint"> ({item.note})</span>}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="mt-5">
      <a href="/about/" class="link font-mono text-sm">More about Derek &rarr;</a>
    </p>
  </Section>

  <!-- 05 Contact -->
  <Section id="contact" num="05" cat="Contact" title="Contact and resume">
    <p class="mt-8 leading-relaxed text-muted">
      Open to cybersecurity internships, CTF collaboration, and security
      projects.
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href="/contact/" class="btn btn-primary">Contact Derek</a>
      <a href={CONTACT.resumePdf} class="btn btn-ghost">Download resume (PDF)</a>
    </div>
  </Section>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
</BaseLayout>

<style>
  .hero-fade {
    mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.9) 0%,
      rgb(0 0 0 / 0.35) 60%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.9) 0%,
      rgb(0 0 0 / 0.35) 60%,
      transparent 100%
    );
  }
</style>
