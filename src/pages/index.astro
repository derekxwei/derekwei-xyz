---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { SITE, CERTIFICATIONS, COMPETITIONS, COMPETITION_SKILLS } from '../consts';

const featuredProjects = (
  await getCollection(
    'projects',
    ({ data }) => (import.meta.env.PROD ? !data.draft : true) && data.featured
  )
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: 'Cybersecurity Student',
  sameAs: [SITE.linkedin],
  alumniOf: {
    '@type': 'HighSchool',
    name: 'MacArthur High School',
  },
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'The University of Texas at San Antonio',
  },
};
---

<BaseLayout title="Derek Wei">
  <!-- Hero -->
  <section class="relative border-b border-line">
    <div class="bg-grid hero-fade absolute inset-0" aria-hidden="true"></div>
    <div class="relative py-16 sm:py-24">
      <p class="kicker normal-case">$ whoami</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
        Derek Wei
      </h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">
        Incoming B.S. Cybersecurity student in the Honors College at The
        University of Texas at San Antonio, focused on red-team fundamentals,
        penetration testing labs, Capture the Flag methodology, and practical
        security tooling. Preparing for the Certified Penetration Testing
        Specialist (CPTS).
      </p>
      <p class="mt-3 max-w-2xl font-mono text-xs leading-relaxed text-faint">
        5x CompTIA certified (CySA+, PenTest+, Security+, Network+, ITF+)
        &middot; graduate of the NEISD iCSI Cybersecurity Program, Class of 2026
      </p>
      <p
        class="mt-5 inline-flex items-center gap-2 rounded-md border border-line bg-panel-2 px-3 py-1.5 font-mono text-xs text-muted"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"
        ></span>
        {SITE.clearance}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/resume/" class="btn btn-primary">View resume</a>
        <a href="/projects/" class="btn btn-ghost">Projects</a>
        <a href="/contact/" class="btn btn-ghost">Contact</a>
      </div>
    </div>
  </section>

  <!-- Selected proof -->
  <section class="py-10" aria-labelledby="selected-proof-heading">
    <h2
      id="selected-proof-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Selected proof
    </h2>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2" role="list">
      <Card
        href="/ctf/broncoctf-2026-ao-sint/"
        title="AO-SINT: evidence-first game geolocation"
        description="Used topography, architecture, map geometry, and sightlines to identify four Arcane Odyssey locations from four screenshots."
        meta="BroncoCTF 2026"
        note="Team idktheflag placed 8th of 753 teams."
        wide
      />
      <Card
        href="/achievements/"
        title="Verified credentials"
        description="Five CompTIA certifications and one Microsoft certification, each independently verifiable on Credly, with competition placements to match."
        meta="Achievements"
      />
      <Card
        href="/Derek_Wei_Resume_Public.pdf"
        title="Resume (PDF)"
        description="One page, ATS-readable, with clickable contact and credential verification links."
        meta="Download"
      />
    </ul>
  </section>

  <!-- Current focus -->
  <section class="border-t border-line py-10" aria-labelledby="current-focus-heading">
    <h2
      id="current-focus-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Current focus
    </h2>
    <ul class="mt-5 grid gap-2.5 sm:grid-cols-2" role="list">
      {
        [
          'Certified Penetration Testing Specialist (CPTS) preparation',
          'Capture the Flag competition practice',
          'Offensive security labs',
          'Cybersecurity portfolio development',
          'Beginning UTSA Cybersecurity Honors coursework',
        ].map((item) => (
          <li class="flex gap-2 text-sm leading-relaxed text-muted">
            <span class="text-accent" aria-hidden="true">
              -
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Certifications -->
  <section class="border-t border-line py-10" aria-labelledby="certifications-heading">
    <h2
      id="certifications-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Certifications
    </h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        CERTIFICATIONS.map((cert) => (
          <li class="panel flex flex-col gap-1 p-4" title={cert.name}>
            {cert.verifyUrl ? (
              <a
                href={cert.verifyUrl}
                class="link self-start font-mono text-sm"
                rel="noopener noreferrer"
                aria-label={`${cert.short}: verify badge on Credly`}
              >
                {cert.short}
              </a>
            ) : (
              <span class="font-mono text-sm text-accent">{cert.short}</span>
            )}
            <span class="text-xs text-muted">{cert.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Focus -->
  <section class="border-t border-line py-10" aria-labelledby="focus-heading">
    <h2
      id="focus-heading"
      class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
    >
      <span class="text-accent" aria-hidden="true">##</span> Focus
    </h2>
    <ul class="mt-5 grid gap-4 md:grid-cols-3" role="list">
      <li class="panel flex flex-col p-5">
        <h3 class="font-mono text-sm text-accent">Offensive security</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">
          Red-team fundamentals and penetration testing methodology, practiced
          in authorized lab environments and reinforced by PenTest+ and ongoing
          CPTS preparation. Blue-team literacy from CySA+ helps connect
          offensive findings back to real-world defense.
        </p>
        <a href="/lab/" class="link mt-4 font-mono text-xs">Lab →</a>
      </li>
      <li class="panel flex flex-col p-5">
        <h3 class="font-mono text-sm text-accent">Capture the Flag</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">
          I compete in events like National Cyber League, BYU CTF, RowdyCon,
          CTF@CIT, and Squ1rrel. CTFs are where offensive fundamentals get
          pressure-tested against real challenges, and sanitized writeups are
          published here as they're finished.
        </p>
        <a href="/ctf/" class="link mt-4 font-mono text-xs">CTF writeups →</a>
      </li>
      <li class="panel flex flex-col p-5">
        <h3 class="font-mono text-sm text-accent">Tooling &amp; labs</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">
          Practical tooling matters: this site ships small browser-based
          security utilities, and an authorized home lab gives me a safe place
          for penetration testing practice and CTF work.
        </p>
        <a href="/tools/" class="link mt-4 font-mono text-xs">Tools →</a>
      </li>
    </ul>
  </section>

  <!-- Featured projects (rendered only when a project is marked featured) -->
  {
    featuredProjects.length > 0 && (
      <section class="border-t border-line py-10" aria-labelledby="featured-projects-heading">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2
            id="featured-projects-heading"
            class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
          >
            <span class="text-accent" aria-hidden="true">##</span> Featured projects
          </h2>
          <a href="/projects/" class="link font-mono text-sm">All projects →</a>
        </div>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2" role="list">
          {featuredProjects.map((project) => (
            <Card
              href={`/projects/${project.id}/`}
              title={project.data.title}
              description={project.data.description}
              meta={fmt(project.data.date)}
              tags={[...project.data.tags]}
              status={project.data.status}
            />
          ))}
        </ul>
      </section>
    )
  }

  <!-- Competition skill areas -->
  <section class="border-t border-line py-10" aria-labelledby="competitions-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2
        id="competitions-heading"
        class="font-mono text-sm uppercase tracking-[0.15em] text-faint"
      >
        <span class="text-accent" aria-hidden="true">##</span> Competition skill areas
      </h2>
      <a href="/achievements/" class="link font-mono text-sm">Achievements →</a>
    </div>
    <ul class="mt-5 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {
        COMPETITION_SKILLS.map((skill) => (
          <li class="flex gap-2 text-sm leading-relaxed text-muted">
            <span class="text-accent" aria-hidden="true">
              -
            </span>
            {skill}
          </li>
        ))
      }
    </ul>
    <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted">
      Developed through {COMPETITIONS.map((c) => c.name).join(', ')}. Full
      placements are on the <a href="/achievements/" class="link">achievements</a>
      page, and sanitized writeups are under
      <a href="/ctf/" class="link">CTF writeups</a> as they're completed.
    </p>
  </section>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
</BaseLayout>

<style>
  .hero-fade {
    mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.9) 0%,
      rgb(0 0 0 / 0.35) 60%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.9) 0%,
      rgb(0 0 0 / 0.35) 60%,
      transparent 100%
    );
  }
</style>
