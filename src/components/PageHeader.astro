---
interface Props {
  /** Small mono label above the title, e.g. "~/projects" */
  kicker?: string;
  title: string;
  lede?: string;
}

const { kicker, title, lede } = Astro.props;
---

<header class="pt-10 pb-2 sm:pt-14">
  {kicker && <p class="kicker">{kicker}</p>}
  <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
  {lede && <p class="mt-4 text-lg leading-relaxed text-prose-body">{lede}</p>}
  <slot />
</header>
