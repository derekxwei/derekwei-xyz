---
interface Props {
  label: string;
  tone?: 'accent' | 'muted' | 'warn';
}

const { label, tone = 'muted' } = Astro.props;

const tones: Record<'accent' | 'muted' | 'warn', string> = {
  accent: 'border-accent/30 bg-accent/10 text-accent',
  muted: 'border-line bg-panel-2 text-muted',
  warn: 'border-warn/30 bg-warn/10 text-warn',
};
---

<span
  class={`inline-flex items-center rounded-full border px-2 py-0.5 font-mono text-[11px] leading-4 ${tones[tone]}`}
>
  {label}
</span>
