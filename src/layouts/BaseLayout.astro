---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** ISO date. Emits article metadata and an Article JSON-LD block when set. */
  publishedTime?: string;
  noindex?: boolean;
  /** Hide the site header and footer for standalone pages like /card. */
  minimal?: boolean;
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  publishedTime,
  noindex = false,
  minimal = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Absolute, because og:image is fetched by crawlers with no page context.
const ogImage = new URL('/og-default.png', Astro.site);
const fullTitle = title === SITE.name ? SITE.title : `${title} · ${SITE.name}`;

// 36 pages declared og:type=article while emitting no article metadata and no
// structured data. A ld+json block is data, not executable script, so it is
// unaffected by script-src 'self'.
const articleSchema =
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: title,
        description,
        url: canonical.href,
        image: ogImage.href,
        inLanguage: 'en',
        author: { '@type': 'Person', name: SITE.name, url: SITE.url },
        publisher: { '@type': 'Person', name: SITE.name, url: SITE.url },
        ...(publishedTime ? { datePublished: publishedTime } : {}),
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && <meta property="article:author" content={SITE.name} />}
    {articleSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0f1a" />
    <!-- Blocking same-origin theme bootstrap: resolves system|dark|light and
         stamps data-theme before first paint so the wrong theme never
         flashes. External file, so the strict CSP (script-src 'self',
         no inline) is preserved. -->
    <script is:inline src="/theme-boot.js"></script>
  </head>
  <body class="flex min-h-dvh flex-col bg-bg font-sans text-ink antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    {!minimal && <Header />}
    <main id="main" class="mx-auto w-full max-w-shell flex-1 px-4 pb-20 sm:px-6 lg:px-10">
      <slot />
    </main>
    {!minimal && <Footer />}
  </body>
</html>
